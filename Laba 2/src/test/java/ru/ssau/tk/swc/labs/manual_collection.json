              "path": ["api", "anal-points"]
            }
          },
          "response": []
        },
        {
          "name": "POST Create Analytic Point",
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "exec": [
                  "// Генерируем тестовые данные",
                  "const x = Math.random() * 100;",
                  "const y = Math.sin(x);",
                  "const derive = Math.cos(x);",
                  "",
                  "pm.variables.set('test_x', x.toFixed(2));",
                  "pm.variables.set('test_y', y.toFixed(4));",
                  "pm.variables.set('test_derive', derive.toFixed(4));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"x\": {{test_x}},\n    \"y\": {{test_y}},\n    \"derive\": {{test_derive}},\n    \"funID\": {{anal_fun_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/api/anal-points",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "anal-points"]
            }
          },
          "response": []
        }
      ]
    },
